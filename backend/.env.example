# ==================================================
# Environment Configuration (Docker-compatible)
# ==================================================
# This file is used by docker-compose via env_file
# DO NOT use localhost for services inside Docker
# ==================================================

# Debug mode
DEBUG=True

# Django
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=UTC

# ==================================================
# PostgreSQL (Docker container: service name = db)
# ==================================================
POSTGRES_DB=halalchicken
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: if settings use DATABASE_URL
DATABASE_URL=postgresql://postgres:root@db:5432/halalchicken

# ==================================================
# Redis / Celery (Docker container: service name = redis)
# ==================================================
REDIS_URL=redis://redis:6379/0

# ==================================================
# Storage
# ==================================================
STORAGE_BACKEND=LOCAL

# ==================================================
# Image validation
# ==================================================
MAX_IMAGE_MB=5

# ==================================================
# JWT
# ==================================================
JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=7

# ==================================================
# CORS (frontend runs on host)
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
